{erl_opts, [debug_info, warnings_as_errors]}.
{minimum_otp_vsn, "28"}.
{deps, [
    {amqp_client, "~> 4.2"}
]}.

{project_app_dirs, ["apps/*"]}.

{shell, [
    {config, "apps/erlkoenig/config/sys.config"},
    {apps, [erlkoenig]}
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        unmatched_returns
    ]},
    {plt_extra_apps, [crypto]}
]}.

{edoc_opts, [{preprocess, true}]}.

{project_plugins, [erlfmt, rebar3_hex, rebar3_ex_doc]}.

{erlfmt, [write]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

%% External modules from sibling projects (erlkoenig_fuse, erlkoenig_elf, erlkoenig_ingest).
%% These are runtime-optional and not rebar3 dependencies.
{xref_ignores, [
    {erlkoenig_fuse_mount_sup, start_mount, 3},
    {erlkoenig_fuse_mount_sup, stop_mount, 1},
    {erlkoenig_fuse_manifest, save, 2},
    {erlkoenig_elf, parse, 1},
    {erlkoenig_elf, seccomp_profile, 1},
    {erlkoenig_ingest, build_rootfs, 2},
    {erlkoenig_ingest, ingest_binary, 3},
    {erlkoenig_ingest, ingest_inline, 3},
    {erlkoenig_ingest, module_info, 1},
    {erlkoenig_sig, verify_binary, 3}
]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {source_url, <<"https://github.com/iRaffnix/erlkoenig">>},
    {extras, [
        <<"README.md">>,
        <<"docs/QUICKSTART.md">>,
        <<"docs/ERROR_CODES.md">>,
        <<"CONTRIBUTING.md">>,
        <<"LICENSE">>
    ]},
    {main, <<"readme">>},
    {api_reference, true},
    {groups_for_extras, [
        {<<"Operator">>, [
            <<"docs/QUICKSTART.md">>,
            <<"docs/ERROR_CODES.md">>
        ]},
        {<<"Contributor">>, [
            <<"CONTRIBUTING.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Container Lifecycle">>, [
            erlkoenig_ct,
            erlkoenig_ct_rt,
            erlkoenig_ct_rt_discover,
            erlkoenig_ct_net,
            erlkoenig_ct_cgroup,
            erlkoenig_ct_volume,
            erlkoenig_ct_security,
            erlkoenig_ct_observe,
            erlkoenig_ct_resources,
            erlkoenig_ct_opts,
            erlkoenig_ct_info,
            erlkoenig_ct_firewall,
            erlkoenig_zone,
            erlkoenig_zone_sup
        ]},
        {<<"Configuration & DSL">>, [
            erlkoenig_config,
            erlkoenig_config_validate,
            erlkoenig_config_flatten,
            erlkoenig_config_drift,
            erlkoenig_config_zone,
            erlkoenig_config_spawn,
            erlkoenig_config_nft
        ]},
        {<<"Networking">>, [
            erlkoenig_net,
            erlkoenig_netcfg,
            erlkoenig_steering,
            erlkoenig_ip_pool
        ]},
        {<<"NFT Firewall">>, [
            nfnl_server,
            nfnl_attr,
            nfnl_response,
            erlkoenig_nft_container,
            erlkoenig_nft_firewall,
            erlkoenig_nft_counter,
            erlkoenig_nft_cgroup,
            erlkoenig_nft_audit,
            erlkoenig_nft_events,
            erlkoenig_nft_ip,
            erlkoenig_nft_ct_guard,
            erlkoenig_nft_sup
        ]},
        {<<"Threat Detection">>, [
            erlkoenig_threat_actor,
            erlkoenig_threat_mesh,
            erlkoenig_threat_sup
        ]},
        {<<"Security Boundaries">>, [
            erlkoenig_admission, erlkoenig_quarantine
        ]},
        {<<"Storage">>, [
            erlkoenig_volume,
            erlkoenig_volume_store,
            erlkoenig_rootfs_builder,
            erlkoenig_artifact_store
        ]},
        {<<"DNS">>, [
            erlkoenig_dns, erlkoenig_dns_filter
        ]},
        {<<"Audit">>, [
            erlkoenig_audit
        ]},
        {<<"Error Framework">>, [
            erlkoenig_error
        ]},
        {<<"Operator CLI">>, [
            ek, ek_event_printer
        ]},
        {<<"OTP Lifecycle">>, [
            erlkoenig_app, erlkoenig_sup, erlkoenig
        ]},
        {<<"ELF Analysis">>, [
            elf_parse,
            elf_parse_symtab,
            elf_lang,
            elf_lang_dwarf,
            elf_lang_go,
            elf_lang_rust,
            elf_dep,
            elf_decode_x86_64,
            elf_decode_aarch64,
            elf_patch,
            elf_report,
            elf_seccomp,
            elf_syscall,
            elf_syscall_db
        ]}
    ]}
]}.

{relx, [
    {release, {erlkoenig, "0.9.0"}, [
        sasl,
        erlkoenig,
        crypto,
        inets,
        ssl,
        public_key,
        compiler,
        amqp_client
    ]},
    {sys_config, "apps/erlkoenig/config/sys.config"},
    {vm_args_src, "apps/erlkoenig/config/vm.args.src"},
    {dev_mode, false},
    {include_erts, true},
    {include_src, false},
    {extended_start_script, true},
    {overlay, [
        {copy, "bin/erlkoenig_wrapper.sh", "bin/erlkoenig"},
        {copy, "dist/erlkoenig.service", "dist/erlkoenig.service"},
        %% Operator CLI `ek`: shell wrapper finds the bundled escript
        %% and delegates to the .escript file in share/.
        {copy, "dist/ek", "bin/ek"},
        {copy, "dist/ek.escript", "share/ek.escript"},
        {copy, "apps/erlkoenig/priv/error_catalog.term", "share/error_catalog.term"},
        %% Operator inspection helpers — thin escripts that attach
        %% to a running node and dump container state / logs / top.
        {copy, "bin/ek-inspect", "bin/ek-inspect"},
        {copy, "bin/ek-logs", "bin/ek-logs"},
        {copy, "bin/ek-ps", "bin/ek-ps"},
        {copy, "bin/ek-top", "bin/ek-top"},
        %% Bundled Elixir runtime (~7 MB) — lets `ek dsl compile` work
        %% on any host with the release installed, without needing a
        %% separate Elixir/Mix install on the operator's machine.
        {copy, "dist/elixir", "elixir"},
        {copy, "README.md", "doc/README.md"},
        {copy, "LICENSE", "doc/LICENSE"},
        %% DSL examples — ship with the release so operators have
        %% runnable templates on the target host.
        {copy, "examples/README.md", "examples/README.md"},
        {copy, "examples/stacks/tutorial.exs", "examples/stacks/tutorial.exs"},
        {copy, "examples/stacks/pod_strategies.exs", "examples/stacks/pod_strategies.exs"},
        {copy, "examples/stacks/simple_echo.exs", "examples/stacks/simple_echo.exs"},
        {copy, "examples/stacks/three_tier_ipvlan.exs", "examples/stacks/three_tier_ipvlan.exs"},
        {copy, "examples/stacks/three_tier_ipvlan_fw.exs", "examples/stacks/three_tier_ipvlan_fw.exs"},
        {copy, "examples/stacks/pod_supervision.exs", "examples/stacks/pod_supervision.exs"},
        {copy, "examples/stacks/logged_echo.exs", "examples/stacks/logged_echo.exs"},
        {copy, "examples/stacks/signed_deployment.exs", "examples/stacks/signed_deployment.exs"},
        {copy, "examples/showcase/case_mgmt_stack.exs", "examples/showcase/case_mgmt_stack.exs"},
        {copy, "examples/firewall/fw_bastion.exs", "examples/firewall/fw_bastion.exs"},
        {copy, "examples/firewall/fw_database.exs", "examples/firewall/fw_database.exs"},
        {copy, "examples/firewall/fw_flowtable.exs", "examples/firewall/fw_flowtable.exs"},
        {copy, "examples/firewall/fw_nat_gateway.exs", "examples/firewall/fw_nat_gateway.exs"},
        {copy, "examples/firewall/fw_web_server.exs", "examples/firewall/fw_web_server.exs"},
        {copy, "examples/dev/dsl_e2e_edge.exs", "examples/dev/dsl_e2e_edge.exs"},
        %% Tutorial series (book chapters 3-6 are walk-throughs).
        {copy, "examples/tutorial", "examples/tutorial"},
        %% Tools
        {copy, "tools/event_consumer.py", "tools/event_consumer.py"},
        {copy, "tools/stream_consumer.py", "tools/stream_consumer.py"}
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all, {d, 'TEST'}]},
        {deps, [
            {assert, {git, "https://github.com/WhatsApp/assert.git", {branch, "main"}}},
            {proper, "1.4.0"}
        ]}
    ]},
    {prod, [
        {relx, [
            {debug_info, strip}
        ]}
    ]}
]}.
